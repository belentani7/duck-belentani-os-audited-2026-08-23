# DUCK Belentani OS — variables de entorno (valores de ejemplo, NO reales)
# Copia a .env y reemplaza con tus valores antes de ejecutar.

# App / OAuth
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Sesión (firma de JWT HS256)
JWT_SECRET=

# Base de datos MySQL (drizzle)
DATABASE_URL=

# Forge (storage, heartbeat, LLM, notificaciones)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Servidor
NODE_ENV=development
PORT=3000

# Análisis (opcional — umami). Si se dejan vacíos, la etiqueta de
# /%VITE_ANALYTICS_ENDPOINT%/umami en client/index.html queda inerte.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=